//+------------------------------------------------------------------+
//| Persistent Lock Structure with GlobalVariable Storage             |
//+------------------------------------------------------------------+
struct PersistentBreakoutLock
{
    string symbol;
    string storageKey;
    datetime lockedD1Time;
    bool isLocked;
    
    void Init(const string sym)
    {
        symbol = sym;
        storageKey = "BO_Lock_" + sym;
        lockedD1Time = 0;
        isLocked = false;
        RecoverFromStorage();
    }
    
    void RecoverFromStorage()
    {
        datetime storedTime = (datetime)GlobalVariableGet(storageKey);
        
        if(storedTime > 0)
        {
            datetime currentD1 = iTime(symbol, PERIOD_D1, 0);
            
            if(storedTime == currentD1)
            {
                lockedD1Time = storedTime;
                isLocked = true;
                
                Print("┌────────────────────────────────────────┐");
                PrintFormat("│  🔒 %s: LOCK RECOVERED", symbol);
                PrintFormat("│     From: GlobalVariable storage");
                PrintFormat("│     Date: %s", TimeToString(storedTime, TIME_DATE));
                PrintFormat("│     Status: LOCKED (no trading today)");
                Print("└────────────────────────────────────────┘");
            }
            else
            {
                GlobalVariableDel(storageKey);
                PrintFormat("✓ %s: Old lock cleared (D1 changed)", symbol);
            }
        }
        else
        {
            PrintFormat("✓ %s: No previous lock found (ready to trade)", symbol);
        }
    }
    
    bool CanTrade()
    {
        datetime currentD1 = iTime(symbol, PERIOD_D1, 0);
        
        if(currentD1 != lockedD1Time && lockedD1Time > 0)
        {
            Print("┌────────────────────────────────────────┐");
            PrintFormat("│  📅 %s: NEW D1 CANDLE", symbol);
            PrintFormat("│     Previous: %s", TimeToString(lockedD1Time, TIME_DATE));
            PrintFormat("│     Current:  %s", TimeToString(currentD1, TIME_DATE));
            PrintFormat("│     Status: UNLOCKED (ready for new trade)");
            Print("└────────────────────────────────────────┘");
            Unlock();
            return true;
        }
        
        if(isLocked)
        {
            static datetime lastLog = 0;
            if(TimeCurrent() - lastLog > 3600)
            {
                PrintFormat("🔒 %s: Still locked for %s", 
                           symbol, TimeToString(lockedD1Time, TIME_DATE));
                lastLog = TimeCurrent();
            }
            return false;
        }
        
        datetime storedTime = (datetime)GlobalVariableGet(storageKey);
        if(storedTime == currentD1 && storedTime > 0)
        {
            lockedD1Time = storedTime;
            isLocked = true;
            PrintFormat("⚠️ %s: Lock state synced from storage", symbol);
            return false;
        }
        
        return true;
    }
    
    void Lock()
    {
        datetime currentD1 = iTime(symbol, PERIOD_D1, 0);
        lockedD1Time = currentD1;
        isLocked = true;
        
        if(!GlobalVariableSet(storageKey, (double)currentD1))
        {
            PrintFormat("⚠️ WARNING: Failed to save lock to storage for %s", symbol);
        }
        
        datetime stored = (datetime)GlobalVariableGet(storageKey);
        bool storageOK = (stored == currentD1);
        
        Print("┌────────────────────────────────────────┐");
        PrintFormat("│  🔒 %s LOCKED FOR TODAY", symbol);
        PrintFormat("│     Lock Time: %s", TimeToString(currentD1, TIME_DATE|TIME_MINUTES));
        PrintFormat("│     Storage Key: %s", storageKey);
        PrintFormat("│     Storage Status: %s", storageOK ? "✅ SAVED" : "❌ FAILED");
        PrintFormat("│     Memory Status: ✅ LOCKED");
        PrintFormat("│");
        PrintFormat("│     ⛔ NO MORE PROCESSING TODAY");
        PrintFormat("│     ⏰ Will unlock at next D1 candle");
        Print("└────────────────────────────────────────┘");
    }
    
    void Unlock()
    {
        isLocked = false;
        lockedD1Time = 0;
        
        if(GlobalVariableCheck(storageKey))
        {
            GlobalVariableDel(storageKey);
        }
        
        PrintFormat("🔓 %s: UNLOCKED (ready for new trade)", symbol);
    }
    
    string GetStatus()
    {
        if(isLocked)
        {
            return StringFormat("🔒 LOCKED (%s)", TimeToString(lockedD1Time, TIME_DATE));
        }
        return "✅ READY";
    }
};

